# ---- Postgres server (local development) ----
# Port on YOUR Mac. Container side is always 5432.
POSTGRES_HOST_PORT=5433
POSTGRES_USER=shoplite_admin
POSTGRES_PASSWORD=shoplite_admin
POSTGRES_DB=postgres

# ---- Per-service database passwords ----
PRODUCT_DB_PASSWORD=shoplite_admin
ORDER_DB_PASSWORD=shoplite_admin
AUTH_DB_PASSWORD=shoplite_admin